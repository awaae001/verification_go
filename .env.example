# Server listen settings
PORT = 8080
LISTEN_ADDRESS = 0.0.0.0

# Directory holding system_config.json.
# The default config file is released here on first startup.
CONFIG_PATH = "data/config/"

# Public service origin used to build verification URLs.
# Leave empty to derive it from the session creation request.
PUBLIC_BASE_URL = ""

# Development mode switch
# Accepted values: 1, true, yes, y, on (anything else is false)
# Default: false
IS_DEV = false

# --- Secrets ---
# When set, the following environment variables override the corresponding
# values in system_config.json.

# Cloudflare Turnstile site key (public, rendered into the page)
TURNSTILE_SITE_KEY = ""

# Cloudflare Turnstile site secret (server-side only, never sent to browsers)
TURNSTILE_SECRET = ""

# Telegram Login client ID (decimal string of the bot ID)
TELEGRAM_CLIENT_ID = ""

# Comma-separated client-name=secret pairs.
TRUSTED_CLIENT_KEYS = ""
