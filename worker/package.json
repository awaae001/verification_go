{
  "name": "telegram-verification-workers",
  "version": "1.0.0",
  "description": "Telegram User Verification System on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env dev",
    "tail": "wrangler tail --env production",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "cloudflare-workers",
    "telegram",
    "verification",
    "hono",
    "durable-objects"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  }
}
